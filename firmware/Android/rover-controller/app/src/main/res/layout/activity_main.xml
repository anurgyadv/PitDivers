<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webViewCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/controllerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#B3000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="Controller active • Left stick drives • B stops"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/lidarMiniCard"
        android:layout_width="240dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/lidar_panel_background"
        android:orientation="vertical"
        android:padding="5dp">

        <com.pitdivers.rovercontroller.lidar.LidarMapView
            android:id="@+id/lidarMiniMap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Expand LiDAR map"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lidarMiniStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingStart="5dp"
                android:text="LiDAR · Connecting…"
                android:textColor="#E9F0F8"
                android:textSize="10sp" />

            <Button
                android:id="@+id/lidarMiniToggle"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="2dp"
                android:text="START"
                android:textSize="9sp" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Connection settings"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="⚙"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/lidarExpandedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2071822"
        android:visibility="gone">

        <com.pitdivers.rovercontroller.lidar.LidarMapView
            android:id="@+id/lidarExpandedMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Expanded LiDAR room map" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#CC0E1B2B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/lidarExpandedStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LiDAR · Connecting…"
                android:textColor="#E9F0F8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/lidarExpandedToggle"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:minHeight="0dp"
                android:text="START"
                android:textSize="11sp" />

            <Button
                android:id="@+id/expandedSettingsButton"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Connection settings"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="⚙"
                android:textSize="18sp" />

            <Button
                android:id="@+id/closeExpandedMap"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:contentDescription="Close expanded LiDAR map"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="×"
                android:textSize="24sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
